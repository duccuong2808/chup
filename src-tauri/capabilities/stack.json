{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "stack",
  "description": "Stack thumbnail: hiển thị, kéo file ra ngoài, các thao tác trên shot.",
  "windows": ["stack"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "drag:default",
    "allow-stack-state",
    "allow-stack-report-size",
    "allow-stack-remove",
    "allow-stack-clear",
    "allow-shot-exists",
    "allow-shot-open",
    "allow-shot-reveal",
    "allow-shot-copy"
  ]
}
